NODE_ENV=development
PORT=5001

# PostgreSQL: usa DATABASE_URL o las variables DB_*
# DATABASE_URL=postgres://usuario:clave@127.0.0.1:5432/maze_tour
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=maze_tour
DB_USER=postgres
DB_PASSWORD=cambia_esta_clave
DB_SSL=false
DB_LOGGING=false
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_IDLE_MS=10000
DB_POOL_ACQUIRE_MS=30000

SESSION_SECRET=genera_una_clave_larga_y_aleatoria
SESSION_DAYS=7
COOKIE_NAME=maze.sid
COOKIE_DOMAIN=
COOKIE_SAME_SITE=lax

FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
FRAME_ANCESTORS='self',http://localhost:5173

# Solo se usa para crear/sembrar administradores. La autorización diaria depende de Users.role.
ADMIN_EMAILS=alvaroquiroz159357@gmail.com,kumi232006@gmail.com

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5001/api/auth/google/callback

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
CHAT_DAILY_LIMIT=500
CHAT_TIMEOUT_MS=15000

# Archivos
MAX_UPLOAD_TOTAL_MB=80
MAX_IMAGE_MB=6
MAX_PDF_MB=12
IMAGE_MAX_WIDTH=2200
IMAGE_MAX_HEIGHT=2200
IMAGE_WEBP_QUALITY=82
# Opcional: carpetas antiguas separadas por coma, relativas al backend o absolutas
LEGACY_UPLOAD_ROOTS=
LEGACY_UPLOAD2_ROOTS=
